# Copy to .env and adjust. Never commit real secrets.
DATABASE_URL="postgresql://taskflow:taskflow@localhost:5432/taskflow_dev"
JWT_SECRET="change-me-to-a-long-random-string-32-chars-min"
PORT=3001

# Database the e2e tests use. They wipe it, so never point this at DATABASE_URL.
# Unset → DATABASE_URL from the shell (CI) → local Postgres taskflow_test.
TEST_DATABASE_URL="postgresql://taskflow:taskflow@localhost:5432/taskflow_test"
