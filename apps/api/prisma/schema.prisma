// Built up slice by slice from docs/architecture/02-data-model.md.
// Session 1 (auth): users, refresh tokens, and the workspace tables /me reads.
// Session 2 (RBAC): projects and project_viewers.
// Session 3 (tasks): tasks.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  owner
  admin
  member
  viewer
}

/// Declaration order is the board's column order (Postgres compares enums by it).
enum TaskStatus {
  todo
  in_progress
  in_review
  done
}

enum Priority {
  low
  medium
  high
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.Citext
  name         String
  passwordHash String   @map("password_hash")
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  refreshTokens  RefreshToken[]
  memberships    Membership[]
  projectViewers ProjectViewer[]
  assignedTasks  Task[]          @relation("assignee")
  createdTasks   Task[]          @relation("creator")

  @@map("users")
}

/// One row per issued refresh token. Only the SHA-256 hash is stored.
/// All tokens from one login share a family; reuse of a used token revokes the family.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("refresh_tokens")
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  memberships Membership[]
  projects    Project[]
  tasks       Task[]

  @@map("workspaces")
}

model Membership {
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  role        Role
  joinedAt    DateTime @default(now()) @map("joined_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@map("memberships")
}

model Project {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  viewers   ProjectViewer[]
  tasks     Task[]

  @@index([workspaceId])
  @@map("projects")
}

/// A viewer membership alone grants nothing: each project a viewer may see has a row here.
model ProjectViewer {
  projectId String   @map("project_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  addedAt   DateTime @default(now()) @map("added_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("project_viewers")
}

model Task {
  id          String     @id @default(uuid()) @db.Uuid
  /// Copied from the project so tenant filters never need a join.
  workspaceId String     @map("workspace_id") @db.Uuid
  projectId   String     @map("project_id") @db.Uuid
  title       String
  description String?
  status      TaskStatus @default(todo)
  priority    Priority   @default(medium)
  assigneeId  String?    @map("assignee_id") @db.Uuid
  dueDate     DateTime?  @map("due_date") @db.Date
  /// Fractional index, compared byte by byte: the migration adds COLLATE "C".
  position    String
  /// Optimistic lock: +1 on every write; a stale version on PATCH/move is a 409.
  version     Int        @default(1)
  createdById String     @map("created_by") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee  User?     @relation("assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User      @relation("creator", fields: [createdById], references: [id])

  @@index([projectId, status, position, id])
  @@map("tasks")
}
