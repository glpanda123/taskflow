# Copy to .env.local and adjust.

# Mock API (default): MSW answers /api/v1 inside the browser, no backend needed.
# Real API: turn the mock off and point Next at the API (see apps/api/README.md).
# NEXT_PUBLIC_API_MOCKING=disabled
# API_URL=http://localhost:3001
# Realtime in production: Vercel doesn't forward WebSockets, so the browser connects
# straight to the API. Unset = this site (mock API, local development).
# NEXT_PUBLIC_REALTIME_URL=wss://api.example.com
